# 训练模块环境变量（复制到 /etc/niii/training-algorithm.env 或 systemd Environment）

NIII_TRAINING_STORAGE=/niii_machine_version/AI_trainning_platform/storage
NIII_TRAINING_PLATFORM_ROOT=/niii_machine_version/AI_trainning_platform
NIII_YOLO_PYTHON=/root/.local/share/mamba/envs/yolo/bin/python

# 可选：训练 HTTP
AUTOLAB_TRAIN_HOST=0.0.0.0
AUTOLAB_TRAIN_PORT=21011
