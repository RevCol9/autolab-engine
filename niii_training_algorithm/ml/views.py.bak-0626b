predictor = None
class SamAutomatedLabel(views.APIView):
    def post(self, request, format=None):
        global predictor
        if predictor == None:
            return Response({"status":"SAM model not loaded"})
        else:
            param_data = request.data
            image_path = "../storage/" + param_data["project_id"] + "/images/" + param_data["image_name"]
            label_save_path = "../storage/" + param_data["project_id"] + "/" + param_data["task_id"] + "/labels/" + param_data["image_name"][:-3]
            label_save_path = label_save_path + "txt"
            hq_token_only = False 
            image = cv2.imread(image_path)
            h,w = image.shape[0:2]
            image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
            predictor.set_image(image)

            # input_box = np.array(param_data["boxes"])
            # input_point = np.array(param_data["points"])
            input_label = None
            if param_data["full_image"] == "True":
                input_box = [[0,0,w-1,h-1]]
            else:
                if len(param_data["boxes"]) == 0:
                    input_box = None
                else:
                    boxes_list = []
                    boxes_json = param_data["boxes"]
                    print(boxes_json)
                    for i in range(len(boxes_json)):
                        print(boxes_json[i])
                        x = int(boxes_json[i]['shape']['x'])
                        y = int(boxes_json[i]['shape']['y'])
                        width = int(boxes_json[i]['shape']['width'])
                        height = int(boxes_json[i]['shape']['height'])
                        boxes_list.append([x,y,x+width,y+height])
                    if(len(param_data["boxes"])>1):
                        input_box = torch.tensor(boxes_list,device=predictor.device)
                    else:
                        input_box = np.array(boxes_list)
                    

                if len(param_data["points"]) == 0:
                    input_point = None
                else:
                    points_list = []
                    points_json = param_data["points"]
                    for i in range(len(points_json)):
                        points_list.append([int(points_json[i]['shape']['x']),int(points_json[i]['shape']['y'])])
                    input_point = np.array(points_list)
                    input_label = np.ones(input_point.shape[0])
            #input_box = np.array([[500, 500, 2000, 1200]])
            #input_point, input_label = None, None
            batch_box = False if input_box is None else len(input_box)>1
            if not batch_box: 
                masks, scores, logits = predictor.predict(
                    point_coords=input_point,
                    point_labels=input_label,
                    box = input_box,
                    multimask_output=False,
                    hq_token_only=hq_token_only, 
                )
                #show_res(masks,scores,input_point, input_label, input_box, 'example9', image)
                convert_mask_to_yolo_format(masks,label_save_path)
            else:
                transformed_box = predictor.transform.apply_boxes_torch(input_box, image.shape[:2])
                masks, scores, logits = predictor.predict_torch(
                    point_coords=input_point,
                    point_labels=input_label,
                    boxes=transformed_box,
                    multimask_output=False,
                    hq_token_only=hq_token_only,
                )
                masks = masks.squeeze(1).cpu().numpy()
                scores = scores.squeeze(1).cpu().numpy()
                input_box = input_box.cpu().numpy()
                convert_mask_to_yolo_format(masks,label_save_path)
            
            return Response({"status":"success"})

class LoadSamModel(views.APIView):
    def post(self, request, format=None):
        global predictor
        if predictor == None:
            sam_checkpoint = "./algorithm_model/SAM/pretrained_checkpoint/sam_hq_vit_b.pth"
            model_type = "vit_b"
            sam = sam_model_registry[model_type](checkpoint=sam_checkpoint)
            sam.to(device="cuda")
            predictor = SamPredictor(sam)
            return Response({"status":"success"})
        else:
            return Response({"status":"model already loaded"})
