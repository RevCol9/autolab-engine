        return Response({"status":"success","results":prediction})

class TrainThread(Thread):
    def __init__(self, name,algorithm_id,params):
        Thread.__init__(self)
        self.name = name
        self.algorithm_id = algorithm_id
        self.param_data = params
        self.stop_flag = False

    def _raise_exc(self, exc_obj):
        if not self.is_alive():

            return
        res = ctypes.pythonapi.PyThreadState_SetAsyncExc(self.ident, ctypes.py_object(exc_obj))

        if res == 0:
            raise RuntimeError("Not existent thread id.")
        elif res > 1:
            ctypes.pythonapi.PyThreadState_SetAsyncExc(self.ident, None)
            raise SystemError("PyThreadState_SetAsyncExc failed.")

    def kill(self):
        self._raise_exc(SystemExit)

    def stop_training(self):
        # 停止训练的方法
        self.stop_flag = True

    def run(self):

        def callback():
            # 在训练过程中调用的回调函数
            if self.stop_flag:
                # 停止训练的操作
                self.kill()

        algorithm_object = registry.endpoints[self.algorithm_id]

        txt_file_path = '/niii_machine_version/AI_trainning_platform/storage/'+self.param_data['projectId'] + '/' + self.param_data['taskId'] + '/classes.txt'
        if self.param_data.get('projectId') == 'algorithms':
            yaml_base = '/niii_machine_version/AI_trainning_platform/storage/algorithms/' + self.param_data['taskId']
            image_path = self.param_data['trainNum'] + '/images'
            txt_to_yaml(yaml_base, image_path, txt_file_path)
        else:
            txt_to_yaml('/niii_machine_version/AI_trainning_platform/storage/'+self.param_data['projectId'],"images",txt_file_path)
        train_result = algorithm_object.train(param=self.param_data, callback=callback)
        # 移除训练结束后的kill调用，让线程自然结束
        # self.kill()

class TrainDetectionView(views.APIView):
    my_thread = None

    def post(self, request, endpoint_name, format=None):
        if(request.data['action'] == 'start'):
            algorithm_status = self.request.query_params.get("status", "production")
            algorithm_version = self.request.query_params.get("version")

            algs = MLAlgorithm.objects.filter(parent_endpoint__name = endpoint_name, status__status = algorithm_status, status__active=True)

            if algorithm_version is not None:
                algs = algs.filter(version = algorithm_version)
            

            if len(algs) == 0:
                return Response(
                    {"status": "Error", "message": "ML algorithm is not available"},
                    status=status.HTTP_400_BAD_REQUEST,
                )
            if len(algs) != 1 and algorithm_status != "ab_testing":
                return Response(
                    {"status": "Error", "message": "ML algorithm selection is ambiguous. Please specify algorithm version."},
                    status=status.HTTP_400_BAD_REQUEST,
                )

            alg_index = 0
            if algorithm_status == "ab_testing":
                alg_index = 0 if rand() < 0.5 else 1

            param_data = request.data
            # Fix model name case sensitivity issue
            if 'model' in param_data:
                param_data['model'] = param_data['model'].lower()
            # img_source = param_data['image_path']
            # weight_path = param_data['weights_path']
            # param = {epochs':param_data['epochs'],'batch_size':param_data['batch_size'],'model':param_data['model'],
            #          'imgsz':param_data['image_size']}
            # algorithm_object = registry.endpoints[algs[alg_index].id]
            # txt_to_yaml("datasets/coco128/","images",'./runs/detect/classes.txt')
            # train_result = algorithm_object.train(param=param_data,project_name='test1',task_name='task1')
            if 'is_continue' in param_data:
                if param_data['is_continue'] == True:
                    param_data['model'] = 'D:/niii_machine_version/AI_trainning_platform/' + param_data['last_train'] + "/weights/best.pt"

            TrainDetectionView.my_thread = TrainThread("YoloDetect", algs[alg_index].id, param_data)
            TrainDetectionView.my_thread.start()
            return Response({"status":"success"})

        elif(request.data['action'] == 'stop'):            
            if TrainDetectionView.my_thread is not None:
                print(" Trainning interruped by user !!!")
                TrainDetectionView.my_thread.stop_training()
                TrainDetectionView.my_thread.kill()  # 等待线程结束
                TrainDetectionView.my_thread = None
                return Response({"status": "success"})


